---
import Head from '../components/Head.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string; description: string; noindex?: boolean; adPlacement?: string; }
const {title, description, noindex = false, adPlacement = ""} = Astro.props;
---
<!doctype html><html lang="ja"><head><Head title={title + '｜副業図鑑'} description={description} noindex={noindex} adPlacement={adPlacement} /></head><body><a class="skip" href="#main">本文へスキップ</a><header><a class="brand" href="/">副業図鑑</a><nav aria-label="メイン"><a href="/#search">副業を探す</a><a href="/guide/">はじめての方へ</a></nav></header><main id="main"><slot /></main><Footer /></body></html>
<style is:global>
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:20px}body{margin:0;background:#fcfcf8;color:#233d34;font:15px/1.9 'Yu Gothic',Meiryo,sans-serif}a{color:#205d42;text-underline-offset:4px}a:hover{color:#7b5729}button,input,select{font:inherit}:focus-visible{outline:3px solid #b16c26;outline-offset:4px}header{max-width:1160px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:23px 32px;border-bottom:1px solid #dfe5d8}.brand{font-size:24px;font-weight:800;text-decoration:none}header nav{display:flex;gap:22px;font-size:13px}main{max-width:1000px;margin:auto;padding:35px 32px 65px}h1{font-size:clamp(27px,4vw,42px);line-height:1.5;margin:18px 0}h2{font-size:23px;margin:0 0 18px}h3{font-size:18px}p{margin:0 0 16px}.lead{color:#5a6b5b;font-size:16px}.eyebrow{font-size:11px;letter-spacing:.15em;color:#697e5a}.breadcrumb{display:flex;gap:8px;flex-wrap:wrap;font-size:12px;margin-bottom:26px}.panel{background:#fff;border:1px solid #dce4d5;border-radius:12px;padding:28px;margin:24px 0}.muted{color:#697460;font-size:13px}.tags{display:flex;gap:8px;flex-wrap:wrap;list-style:none;padding:0}.tags li{font-size:12px;background:#eaf0e2;border-radius:20px;padding:4px 13px}.notice{padding:16px 20px;background:#f0f3e7;border-left:3px solid #78905a;border-radius:3px;font-size:13px;margin:24px 0}.button{display:inline-block;padding:10px 20px;background:#205a43;color:#fff;border-radius:6px;text-decoration:none;font-size:14px}.button:hover{color:#fff;background:#123f2e}.steps{padding-left:24px}.steps li{padding:7px 0 13px 8px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.grid .panel{margin:0}.toc{display:flex;flex-wrap:wrap;gap:9px 22px;font-size:13px}.service{border-top:1px solid #e5ebde;padding-top:18px;margin-top:18px}.service h3{margin:0 0 8px}.service p{font-size:14px}.service a{display:inline-block;font-weight:700}.related{padding:18px;border:1px solid #dce4d5;border-radius:8px;text-decoration:none;background:#fff}.related span{display:block;font-size:12px;color:#697460}.related strong{display:block;margin:4px 0}details{border-bottom:1px solid #e1e7db;padding:15px 0}summary{cursor:pointer;font-weight:700}details p{margin:12px 0 0;color:#5c6c57}.skip{position:absolute;top:-100px;background:white;padding:12px}.skip:focus{top:8px}dl{margin:0}dt{font-size:13px;color:#6b785f}dd{margin:4px 0 20px;overflow-wrap:anywhere}.ad{font-size:13px;background:#fff1db;border:1px solid #e3ceaa;padding:12px 18px;border-radius:6px}.article-head{padding:20px 0}.article-head .lead{max-width:720px}li+li{margin-top:6px}@media(max-width:600px){header{padding:18px 20px;gap:12px}.brand{font-size:21px}header nav{gap:12px;font-size:11px}main{padding:25px 20px 45px}.panel{padding:22px 18px}.grid{grid-template-columns:1fr}h2{font-size:20px}.lead{font-size:14px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>