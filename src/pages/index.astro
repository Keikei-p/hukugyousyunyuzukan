---
import { jobs } from '../data/jobs';
import Head from '../components/Head.astro';
import Footer from '../components/Footer.astro';
import AdSlot from '../components/AdSlot.astro';
const filters = ['在宅', 'スマホ', '初期費用0円', '未経験OK', 'AI'];
const title = '副業図鑑｜あなたに合う副業を見つけよう';
const description = '在宅・スマホ・初期費用0円・未経験OK・AIなどの条件から、副業を検索・比較。自分の暮らしに合う副業と、最初の一歩を見つけよう。';
---
<!doctype html>
<html lang="ja">
  <head><Head title={title} description={description} adPlacement="home" /></head>
  <body>
    <a class="skip" href="#main">本文へスキップ</a>
    <header><div class="container header-inner"><a class="brand" href="/" aria-label="副業図鑑 ホーム"><span class="brand-icon" aria-hidden="true">副</span>副業図鑑<span class="brand-caption">はたらく選択肢を、もっと。</span></a><a class="nav" href="#search">副業を探す <span aria-hidden="true">↗</span></a></div></header>
    <main id="main">
      <section class="hero container" aria-labelledby="hero-title">
        <div><p class="eyebrow">YOUR NEXT CHAPTER</p><h1 id="hero-title">「自分らしい」が見つかる、<br /><span>副業のはじめかた。</span></h1><p class="intro">得意なことも、これから挑戦したいことも。<br />あなたの暮らしに合う、もうひとつの働き方を探そう。</p><a class="hero-link" href="#search">ぴったりの副業を探す <span aria-hidden="true">↓</span></a></div>
        <div class="hero-art" aria-hidden="true"><div class="orbit"></div><span class="art-note note-one">好きな場所で</span><div class="book"><span>SIDE JOBS</span><strong>副業<br />図鑑<span class="book-star">✦</span></strong><span>あなたの可能性を、ひらこう。</span></div><span class="art-note note-two">自分のペースで ✧</span></div>
      </section>
      <section id="search" class="directory" aria-labelledby="directory-title"><div class="container">
        <div class="section-heading"><div><p class="eyebrow">FIND YOUR SIDE JOB</p><h2 id="directory-title">あなたに合う副業を探す</h2></div><span class="small">小さな一歩から、はじめよう。</span></div>
        <div class="search-panel"><label for="query" class="input-label">キーワードで検索</label><div class="search-input"><span aria-hidden="true">⌕</span><input id="query" type="search" placeholder="副業名やキーワードを入力（例：文章、SNS）" autocomplete="off" /></div><fieldset><legend>気になる条件を選ぶ <span>複数選択可・すべての条件に一致</span></legend><div class="filters">{filters.map(filter => <label class="chip"><input type="checkbox" name="filter" value={filter} /><span>{filter}</span></label>)}</div></fieldset><button id="reset" type="button" class="reset">条件をリセット</button></div>
        <noscript><p>検索・絞り込み・並び替えを使うにはJavaScriptを有効にしてください。副業一覧はそのままご覧いただけます。</p></noscript>
        <div class="results-bar"><p id="result-count" role="status" aria-live="polite" aria-atomic="true"><strong>{jobs.length}</strong> 件の副業</p><div class="sort"><label for="sort">並び替え</label><select id="sort"><option value="recommended">おすすめ順</option><option value="name">名前順（五十音）</option></select></div></div>
        <div id="jobs" class="cards">{jobs.map((job, index) => <article class="card" data-name={job.reading} data-score={job.score} data-tags={JSON.stringify(job.tags)} data-search={[job.name, job.reading, job.category, job.description, job.equipment, ...job.tags].join(' ')}><div class="card-top"><span class="job-icon" aria-hidden="true">{job.icon}</span><span class="category">{job.category}</span><span class="number">0{index + 1}</span></div><h3><a href={`/jobs/${job.slug}/`}>{job.name}</a></h3><p class="description">{job.description}</p><ul class="tags" aria-label="特徴">{job.tags.map(tag => <li>{tag}</li>)}</ul><div class="equipment"><span>用意するもの</span><strong>{job.equipment}</strong></div><details><summary>はじめの一歩 <span aria-hidden="true">＋</span></summary><p>{job.first}</p></details><a class="detail-link" href={`/jobs/${job.slug}/`} aria-label={`${job.name}の始め方を詳しく見る`}>始め方を詳しく見る <span aria-hidden="true">→</span></a></article>)}</div>
        <div id="empty" class="empty" hidden><span aria-hidden="true">⌕</span><h3>条件に合う副業が見つかりませんでした</h3><p>キーワードを変えるか、選択した条件を減らしてみてください。</p><button id="empty-reset" type="button">すべての副業を見る</button></div>
        <p class="disclaimer">おすすめ順は編集上の紹介順です。収益や成果を比較した順位ではありません。<br />「初期費用0円」は必要な機器・通信環境を持っている場合の目安です。利用サービスによって手数料などがかかる場合があります。</p>
      </div></section>
      <div class="container"><AdSlot placement="home" /></div>
      <section class="closing container"><span aria-hidden="true">✦</span><div><h2>最初は、小さな「やってみたい」から。</h2><p>気になる副業を見つけたら、詳しい始め方も読んでみよう。</p></div></section>
    </main>
    <Footer />
  </body>
</html>
<script>
  const query = document.querySelector<HTMLInputElement>('#query')!;
  const sort = document.querySelector<HTMLSelectElement>('#sort')!;
  const filters = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="filter"]'));
  const list = document.querySelector<HTMLElement>('#jobs')!;
  const cards = Array.from(list.querySelectorAll<HTMLElement>('.card'));
  const count = document.querySelector<HTMLElement>('#result-count')!;
  const empty = document.querySelector<HTMLElement>('#empty')!;
  const normalize = (value: string) => value.normalize('NFKC').toLocaleLowerCase('ja');
  function update(syncUrl = true) {
    const terms = normalize(query.value).trim().split(/\s+/).filter(Boolean);
    const selected = filters.filter(filter => filter.checked).map(filter => filter.value);
    let visible = 0;
    const ordered = [...cards].sort((a, b) => sort.value === 'name'
      ? a.dataset.name!.localeCompare(b.dataset.name!, 'ja')
      : Number(b.dataset.score) - Number(a.dataset.score));
    for (const card of ordered) {
      const tags: string[] = JSON.parse(card.dataset.tags!);
      card.hidden = !terms.every(term => normalize(card.dataset.search!).includes(term)) || !selected.every(tag => tags.includes(tag));
      if (!card.hidden) visible++;
      list.append(card);
    }
    count.textContent = `${visible} 件の副業`;
    empty.hidden = visible !== 0;
    if (syncUrl) {
      const url = new URL(location.href);
      url.searchParams.delete("q"); url.searchParams.delete("filter"); url.searchParams.delete("sort");
      if(query.value.trim()) url.searchParams.set("q", query.value.trim());
      selected.forEach(tag => url.searchParams.append("filter", tag));
      if(sort.value === "name") url.searchParams.set("sort", "name");
      history.replaceState(null, "", url);
    }
  }
  function reset() {
    query.value = '';
    filters.forEach(filter => { filter.checked = false; });
    sort.value = 'recommended';
    update();
    query.focus();
  }
  query.addEventListener('input', () => update());
  sort.addEventListener('change', () => update());
  filters.forEach(filter => filter.addEventListener('change', () => update()));
  document.querySelector('#reset')!.addEventListener('click', reset);
  document.querySelector('#empty-reset')!.addEventListener('click', reset);
  const restore = () => {
    const params = new URLSearchParams(location.search);
    query.value = params.get('q') || '';
    filters.forEach(filter => { filter.checked = params.getAll('filter').includes(filter.value); });
    sort.value = params.get('sort') === 'name' ? 'name' : 'recommended';
    update(false);
  };
  window.addEventListener('pageshow', restore);
  window.addEventListener('popstate', restore);
  restore();
</script>
