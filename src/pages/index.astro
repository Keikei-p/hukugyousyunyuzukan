---
import { jobs } from '../data/jobs';
import Head from '../components/Head.astro';
import Footer from '../components/Footer.astro';
import AdSlot from '../components/AdSlot.astro';
import { categories } from '../data/categories';
const filters = ['在宅', 'スマホ', 'パソコン', '初期費用0円', '未経験OK', 'AI'];
const categoryCounts = categories.map(item => ({ ...item, count: jobs.filter(job => job.category === item.name).length }));
const title = '副業収入図鑑｜初心者向け副業・副収入・AI・アフィリエイト';
const description = '初心者向けの在宅副業・スマホ副業・AI副業から、副収入の作り方、アフィリエイト・広告収入まで。自分に合う働き方と始め方を分かりやすく紹介します。';
---
<!doctype html>
<html lang="ja">
  <head><Head title={title} description={description} adPlacement="home" /></head>
  <body>
    <a class="skip" href="#main">本文へスキップ</a>
    <header><div class="container header-inner"><a class="brand" href="/" aria-label="副業収入図鑑 ホーム"><span class="brand-icon" aria-hidden="true">副</span>副業収入図鑑<span class="brand-caption">はたらく選択肢を、もっと。</span></a><a class="nav" href="#search">副業を探す <span aria-hidden="true">↗</span></a></div></header>
    <main id="main">
      <section class="hero container" aria-labelledby="hero-title">
        <div><p class="eyebrow">SIDE JOB & SIDE INCOME GUIDE</p><h1 id="hero-title">初心者のための、<br /><span>副業・副収入図鑑。</span></h1><p class="intro">在宅・スマホ・AIを使った副業から、<br />アフィリエイトや広告収入まで。自分に合う始め方を探そう。</p><a class="hero-link" href="#topics">目的から探す <span aria-hidden="true">↓</span></a></div>
        <div class="hero-art" aria-hidden="true"><div class="orbit"></div><span class="art-note note-one">好きな場所で</span><div class="book"><span>SIDE JOBS</span><strong>副業<br />図鑑<span class="book-star">✦</span></strong><span>あなたの可能性を、ひらこう。</span></div><span class="art-note note-two">自分のペースで ✧</span></div>
      </section>
      <section id="topics" class="topics container" aria-labelledby="topics-title">
        <div class="section-heading"><div><p class="eyebrow">START FROM YOUR GOAL</p><h2 id="topics-title">目的から副業・副収入を探す</h2></div><span class="small">知りたいことから、最短で。</span></div>
        <div class="topic-grid">
          <a class="topic-card" href="/beginner-side-job/"><span>01</span><strong>副業をはじめる</strong><p>初心者向けの選び方、在宅・スマホ副業、安全に始めるための基本。</p></a>
          <a class="topic-card" href="/side-income-10000/"><span>02</span><strong>副収入をつくる</strong><p>月1万円を最初の目標に、時間と作業を整理して無理なく続ける考え方。</p></a>
          <a class="topic-card" href="/ai-side-job/"><span>03</span><strong>AI副業を知る</strong><p>生成AIを補助に使う仕事、始め方、確認しておきたい注意点。</p></a>
          <a class="topic-card" href="/affiliate/"><span>04</span><strong>アフィリエイト・広告収入</strong><p>ブログなどで収益が発生する仕組みと、初心者が先に知るべき基礎。</p></a>
        </div>
        <div class="topic-links" aria-label="人気テーマ">
          <a href="/home-side-job/">在宅副業</a><a href="/smartphone-side-job/">スマホ副業</a><a href="/safe-side-job/">安全な副業</a><a href="/ad-income/">広告収入</a>
        </div>
        <a class="finder-cta" href="/diagnosis/"><span>5問で条件を整理</span><strong>何を選べばいいか迷ったら、副業診断 →</strong></a>
      </section>
      <section class="categories container" aria-labelledby="categories-title">
        <div class="section-heading"><div><p class="eyebrow">BROWSE BY CATEGORY</p><h2 id="categories-title">カテゴリから探す</h2></div><span class="small">{jobs.length}種類を掲載中</span></div>
        <div class="category-grid">{categoryCounts.map(item => <a class="category-card" href={`/category/${item.slug}/`}><strong>{item.name}</strong><span>{item.count}件 →</span></a>)}</div>
      </section>
      <section id="search" class="directory" aria-labelledby="directory-title"><div class="container">
        <div class="section-heading"><div><p class="eyebrow">FIND YOUR SIDE JOB</p><h2 id="directory-title">あなたに合う副業を探す</h2></div><span class="small">小さな一歩から、はじめよう。</span></div>
        <div class="search-panel"><label for="query" class="input-label">キーワードで検索</label><div class="search-input"><span aria-hidden="true">⌕</span><input id="query" type="search" placeholder="副業名やキーワードを入力（例：文章、SNS）" autocomplete="off" /></div><fieldset><legend>使える環境・条件 <span>複数選択可・すべての条件に一致</span></legend><div class="filters">{filters.map(filter => <label class="chip"><input type="checkbox" name="filter" value={filter} /><span>{filter}</span></label>)}</div></fieldset><div class="advanced-selects"><label>難易度<select id="difficulty"><option value="">指定なし</option><option value="初級">初級</option><option value="初中級">初中級</option><option value="中級">中級</option></select></label><label>仕事タイプ<select id="workstyle"><option value="">指定なし</option><option value="案件型">案件型</option><option value="継続案件型">継続案件型</option><option value="販売型">販売型</option><option value="運営型">運営型</option></select></label><label>スマホ適性<select id="phone-fit"><option value="">指定なし</option><option value="high">スマホ中心でしやすい</option><option value="usable">スマホを活用できる</option></select></label><label>初期費用感<select id="cost-fit"><option value="">指定なし</option><option value="low">低めを優先</option></select></label></div><button id="reset" type="button" class="reset">条件をリセット</button></div>
        <noscript><p>検索・絞り込み・並び替えを使うにはJavaScriptを有効にしてください。副業一覧はそのままご覧いただけます。</p></noscript>
        <div class="results-bar"><p id="result-count" role="status" aria-live="polite" aria-atomic="true"><strong>{jobs.length}</strong> 件の副業</p><div class="sort"><label for="sort">並び替え</label><select id="sort"><option value="editorial">掲載順</option><option value="name">名前順（五十音）</option></select></div></div>
        <div id="jobs" class="cards">{jobs.map((job, index) => <article class="card" data-name={job.reading} data-title={job.name} data-slug={job.slug} data-category={job.category} data-equipment={job.equipment} data-difficulty={job.difficulty} data-workstyle={job.workStyle} data-startcost={job.startCost} data-smartphone={job.smartphone} data-aiuse={job.aiUse} data-score={job.score} data-tags={JSON.stringify(job.tags)} data-search={[job.name, job.reading, job.category, job.description, job.equipment, job.difficulty, job.workStyle, ...job.tags].join(' ')}><div class="card-top"><span class="job-icon" aria-hidden="true">{job.icon}</span><span class="category">{job.category}</span><span class="number">{String(index + 1).padStart(2, '0')}</span></div><h3><a href={`/jobs/${job.slug}/`}>{job.name}</a></h3><p class="description">{job.description}</p><ul class="tags" aria-label="特徴">{job.tags.map(tag => <li>{tag}</li>)}</ul><div class="quick-facts"><span>難易度 <strong>{job.difficulty}</strong></span><span>スマホ <strong>{job.smartphone}</strong></span></div><div class="equipment"><span>用意するもの</span><strong>{job.equipment}</strong></div><label class="compare-check"><input class="compare-input" type="checkbox" value={job.slug} /><span>比較に追加</span></label><details><summary>はじめの一歩 <span aria-hidden="true">＋</span></summary><p>{job.first}</p></details><a class="detail-link" href={`/jobs/${job.slug}/`} aria-label={`${job.name}の始め方を詳しく見る`}>始め方を詳しく見る <span aria-hidden="true">→</span></a></article>)}</div>
        <div id="compare-bar" class="compare-bar" hidden><div><strong id="compare-count">0件選択</strong><span>最大3件まで横並びで比較できます</span></div><div class="compare-actions"><button id="compare-clear" type="button">選択解除</button><button id="compare-open" type="button" class="compare-primary">比較する</button></div></div>
        <dialog id="compare-dialog" class="compare-dialog"><form method="dialog" class="dialog-head"><div><p class="eyebrow">COMPARE SIDE JOBS</p><h2>副業を比較</h2></div><button aria-label="比較を閉じる">×</button></form><div class="compare-scroll"><table><thead id="compare-head"></thead><tbody id="compare-body"></tbody></table></div><p class="muted">各項目は仕事内容を整理した目安です。案件や利用サービスによって条件は変わります。</p></dialog>
        <div id="empty" class="empty" hidden><span aria-hidden="true">⌕</span><h3>条件に合う副業が見つかりませんでした</h3><p>キーワードを変えるか、選択した条件を減らしてみてください。</p><button id="empty-reset" type="button">すべての副業を見る</button></div>
        <p class="disclaimer">掲載順は編集上の並びです。収益性・将来性・成果を評価したランキングではありません。<br />「初期費用0円」は必要な機器・通信環境を持っている場合の目安です。利用サービスによって手数料などがかかる場合があります。</p>
      </div></section>
      <div class="container"><AdSlot placement="home" /></div>
      <section class="closing container"><span aria-hidden="true">✦</span><div><h2>最初は、小さな「やってみたい」から。</h2><p>気になる副業を見つけたら、詳しい始め方も読んでみよう。</p></div></section>
    </main>
    <Footer />
  </body>
</html>
<script>
  const query = document.querySelector<HTMLInputElement>('#query')!;
  const sort = document.querySelector<HTMLSelectElement>('#sort')!;
  const difficulty = document.querySelector<HTMLSelectElement>('#difficulty')!;
  const workstyle = document.querySelector<HTMLSelectElement>('#workstyle')!;
  const phoneFit = document.querySelector<HTMLSelectElement>('#phone-fit')!;
  const costFit = document.querySelector<HTMLSelectElement>('#cost-fit')!;
  const filters = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="filter"]'));
  const list = document.querySelector<HTMLElement>('#jobs')!;
  const cards = Array.from(list.querySelectorAll<HTMLElement>('.card'));
  const count = document.querySelector<HTMLElement>('#result-count')!;
  const empty = document.querySelector<HTMLElement>('#empty')!;
  const compareInputs = Array.from(document.querySelectorAll<HTMLInputElement>('.compare-input'));
  const compareBar = document.querySelector<HTMLElement>('#compare-bar')!;
  const compareCount = document.querySelector<HTMLElement>('#compare-count')!;
  const compareOpen = document.querySelector<HTMLButtonElement>('#compare-open')!;
  const compareClear = document.querySelector<HTMLButtonElement>('#compare-clear')!;
  const compareDialog = document.querySelector<HTMLDialogElement>('#compare-dialog')!;
  const compareHead = document.querySelector<HTMLElement>('#compare-head')!;
  const compareBody = document.querySelector<HTMLElement>('#compare-body')!;
  const normalize = (value: string) => value.normalize('NFKC').toLocaleLowerCase('ja');

  const selectedCards = () => compareInputs
    .filter(input => input.checked)
    .map(input => input.closest<HTMLElement>('.card')!)
    .filter(Boolean);

  function updateCompare() {
    const selected = selectedCards();
    compareBar.hidden = selected.length === 0;
    compareCount.textContent = `${selected.length}件選択`;
    compareOpen.disabled = selected.length < 2;
    const reachedMax = selected.length >= 3;
    compareInputs.forEach(input => { if (!input.checked) input.disabled = reachedMax; });
  }

  function cell(text: string, tag: 'th' | 'td' = 'td') {
    const node = document.createElement(tag);
    node.textContent = text;
    return node;
  }

  function openCompare() {
    const selected = selectedCards();
    if (selected.length < 2) return;
    compareHead.replaceChildren();
    compareBody.replaceChildren();
    const headRow = document.createElement('tr');
    headRow.append(cell('比較項目', 'th'));
    selected.forEach(card => headRow.append(cell(card.dataset.title || '', 'th')));
    compareHead.append(headRow);
    const rows: Array<[string, string]> = [
      ['カテゴリー', 'category'],
      ['難易度', 'difficulty'],
      ['仕事タイプ', 'workstyle'],
      ['初期費用感', 'startcost'],
      ['スマホ適性', 'smartphone'],
      ['AI活用', 'aiuse'],
      ['主な環境', 'equipment']
    ];
    rows.forEach(([label, key]) => {
      const row = document.createElement('tr');
      row.append(cell(label, 'th'));
      selected.forEach(card => row.append(cell(card.dataset[key] || '—')));
      compareBody.append(row);
    });
    const links = document.createElement('tr');
    links.append(cell('詳しく見る', 'th'));
    selected.forEach(card => {
      const td = document.createElement('td');
      const a = document.createElement('a');
      a.href = `/jobs/${card.dataset.slug}/`;
      a.textContent = '詳細ページ →';
      td.append(a);
      links.append(td);
    });
    compareBody.append(links);
    compareDialog.showModal();
  }
  function update(syncUrl = true) {
    const terms = normalize(query.value).trim().split(/\s+/).filter(Boolean);
    const selected = filters.filter(filter => filter.checked).map(filter => filter.value);
    let visible = 0;
    const ordered = [...cards].sort((a, b) => sort.value === 'name'
      ? a.dataset.name!.localeCompare(b.dataset.name!, 'ja')
      : Number(b.dataset.score) - Number(a.dataset.score));
    for (const card of ordered) {
      const tags: string[] = JSON.parse(card.dataset.tags!);
      const matchesText = terms.every(term => normalize(card.dataset.search!).includes(term));
      const matchesTags = selected.every(tag => tags.includes(tag));
      const matchesDifficulty = !difficulty.value || card.dataset.difficulty === difficulty.value;
      const matchesWorkstyle = !workstyle.value || card.dataset.workstyle === workstyle.value;
      const phone = card.dataset.smartphone || '';
      const matchesPhone = !phoneFit.value
        || (phoneFit.value === 'high' && phone === '高')
        || (phoneFit.value === 'usable' && ['高','中','補助'].includes(phone));
      const matchesCost = !costFit.value || (costFit.value === 'low' && (card.dataset.startcost || '').startsWith('低'));
      card.hidden = !(matchesText && matchesTags && matchesDifficulty && matchesWorkstyle && matchesPhone && matchesCost);
      if (!card.hidden) visible++;
      list.append(card);
    }
    count.textContent = `${visible} 件の副業`;
    empty.hidden = visible !== 0;
    if (syncUrl) {
      const url = new URL(location.href);
      ["q","filter","sort","difficulty","workstyle","phone","cost"].forEach(key => url.searchParams.delete(key));
      if(query.value.trim()) url.searchParams.set("q", query.value.trim());
      selected.forEach(tag => url.searchParams.append("filter", tag));
      if(difficulty.value) url.searchParams.set("difficulty", difficulty.value);
      if(workstyle.value) url.searchParams.set("workstyle", workstyle.value);
      if(phoneFit.value) url.searchParams.set("phone", phoneFit.value);
      if(costFit.value) url.searchParams.set("cost", costFit.value);
      if(sort.value === "name") url.searchParams.set("sort", "name");
      history.replaceState(null, "", url);
    }
  }
  function reset() {
    query.value = '';
    filters.forEach(filter => { filter.checked = false; });
    sort.value = 'editorial';
    difficulty.value = '';
    workstyle.value = '';
    phoneFit.value = '';
    costFit.value = '';
    update();
    query.focus();
  }
  query.addEventListener('input', () => update());
  sort.addEventListener('change', () => update());
  [difficulty, workstyle, phoneFit, costFit].forEach(select => select.addEventListener('change', () => update()));
  filters.forEach(filter => filter.addEventListener('change', () => update()));
  compareInputs.forEach(input => input.addEventListener('change', () => {
    if (selectedCards().length > 3) input.checked = false;
    updateCompare();
  }));
  compareOpen.addEventListener('click', openCompare);
  compareClear.addEventListener('click', () => {
    compareInputs.forEach(input => { input.checked = false; input.disabled = false; });
    updateCompare();
  });
  document.querySelector('#reset')!.addEventListener('click', reset);
  document.querySelector('#empty-reset')!.addEventListener('click', reset);
  const restore = () => {
    const params = new URLSearchParams(location.search);
    query.value = params.get('q') || '';
    filters.forEach(filter => { filter.checked = params.getAll('filter').includes(filter.value); });
    sort.value = params.get('sort') === 'name' ? 'name' : 'editorial';
    difficulty.value = params.get('difficulty') || '';
    workstyle.value = params.get('workstyle') || '';
    phoneFit.value = params.get('phone') || '';
    costFit.value = params.get('cost') || '';
    update(false);
    updateCompare();
  };
  window.addEventListener('pageshow', restore);
  window.addEventListener('popstate', restore);
  restore();
</script>
<style>
