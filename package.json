{
  "name": "fukugyo-zukan",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check:content": "node scripts/check-content.mjs",
    "check:release": "node scripts/check-content.mjs --release",
    "prebuild": "npm test && npm run check:release",
    "check:output": "node scripts/check-output.mjs",
    "verify": "npm run build",
    "test": "node scripts/run-tests.mjs",
    "postbuild": "npm run check:output && node scripts/release-id.mjs",
    "check:live": "node scripts/check-live.mjs"
  },
  "dependencies": {
    "astro": "^7.3.3"
  },
  "allowScripts": {
    "esbuild": true
  }
}
